# 本地凭据模板（复制为 .env 后填写，.env 已被 .gitignore 忽略，不会入库）
# 复制命令: cp .env.example .env

# MySQL（colorful_geo 库）
GEO_DB_URL=jdbc:mysql://127.0.0.1:3306/colorful_geo?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
GEO_DB_USER=geo_app
GEO_DB_PASS=<在此填写数据库密码>

# 可选：Playwright 浏览器目录（默认 /tmp/pw-browsers）
# PLAYWRIGHT_BROWSERS_PATH=/tmp/pw-browsers

# 可选：覆盖 IntelliJ 自带 Maven 路径
# MVN=/Applications/IntelliJ IDEA.app/Contents/plugins/maven/lib/maven3/bin/mvn
